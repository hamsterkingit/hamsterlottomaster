// 로컬 개발용 Supabase 설정 파일
// 이 파일을 복사해서 supabase-config.local.js로 이름을 변경하고
// 실제 Supabase URL과 Key를 입력하세요.
// ⚠️ 이 파일은 .gitignore에 포함되어 있어 GitHub에 업로드되지 않습니다.

// supabase-config.js에서 로컬 설정을 로드하는 함수
function loadLocalConfig() {
    const SUPABASE_URL = 'YOUR_SUPABASE_URL'; // 여기에 Supabase URL 입력
    const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY'; // 여기에 Supabase Anon Key 입력
    
    if (SUPABASE_URL !== 'YOUR_SUPABASE_URL' && SUPABASE_ANON_KEY !== 'YOUR_SUPABASE_ANON_KEY') {
        supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        console.log('✅ Supabase 클라이언트 초기화 완료 (로컬 설정 사용)');
    } else {
        console.warn('⚠️ 로컬 Supabase 설정이 필요합니다.');
    }
}
